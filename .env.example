# Copiar como .env y completar con los valores reales (.env no se versiona).

# ── Base de datos (externa) ───────────────────────────────────────────────────────────────
# oracle (GCTIC) | postgresql — se fija al construir la imagen del core.
SAMEC_DB_KIND=oracle
# Oracle 19c:  jdbc:oracle:thin:@<host>:1521:<SID>   (o @//<host>:1521/<servicio>)
# PostgreSQL:  jdbc:postgresql://host.docker.internal:5432/samec
SAMEC_DB_URL=jdbc:oracle:thin:@<host>:1521:<SID>
SAMEC_DB_USER=
SAMEC_DB_PASSWORD=

# ── URL pública del frontend (enlaces de los correos y CORS) ──────────────────────────────
SAMEC_APP_URL=http://<IP_DEL_SERVIDOR>:8754
# true en cuanto el despliegue tenga HTTPS.
SAMEC_COOKIE_SECURE=false

# ── Primer administrador (se crea solo si todavía no existe ninguno) ──────────────────────
# Cambiar la contraseña tras el primer ingreso; después se pueden dejar vacías.
SAMEC_ADMIN_USERNAME=admin
SAMEC_ADMIN_EMAIL=
SAMEC_ADMIN_PASSWORD=

# ── reCAPTCHA v3 (opcional; las dos claves van juntas) ────────────────────────────────────
SAMEC_RECAPTCHA_ENABLED=false
SAMEC_RECAPTCHA_SECRET=
SAMEC_RECAPTCHA_SITE_KEY=

# ── Correo (email-service) ────────────────────────────────────────────────────────────────
# Dirección remitente.
EMAIL_USERNAME=samec@essalud.gob.pe
# exchange (relay interno mail.essalud.gob.pe:25, sin credenciales) | gmail-api
MAIL_PROVIDER=exchange
# Solo si MAIL_PROVIDER=gmail-api (ver email/.../GmailApiEmailService.java)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
